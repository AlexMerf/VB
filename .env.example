# Шаблон окружения. Скопируйте в .env и заполните значения.
# ВАЖНО: эти переменные читаются только на сервере (Server Action / route handler).
# Никогда не добавляйте префикс NEXT_PUBLIC_ — токен окажется в клиентском бандле.

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата/канала, куда приходят заявки с брифа
TELEGRAM_CHAT_ID=
